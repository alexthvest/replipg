# Copy to .env (ignored), chmod 600 .env, then fill in these two values locally.
# Empty credentials intentionally fail validation before database or network I/O.
REPLIPG_BOT_TOKEN=
REPLIPG_STORAGE_DIR=

# Assert that the storage directory is on a persistent local filesystem.
REPLIPG_STORAGE_FILESYSTEM=local
REPLIPG_DEPLOYMENT_MODE=single
REPLIPG_POLL_TIMEOUT=30s
REPLIPG_BUSY_TIMEOUT=5s
REPLIPG_HANDLER_TIMEOUT=30s
REPLIPG_RETRY_INITIAL=1s
REPLIPG_RETRY_MAXIMUM=1m
REPLIPG_RETRY_ATTEMPTS=5
REPLIPG_CLAIM_LEASE=1m
REPLIPG_SHUTDOWN_DEADLINE=30s

# Self-only character probes and five-second recovery.
# Accepts exactly true or false. Keep false outside a dedicated test deployment.
REPLIPG_DEV_CHARACTER=false

# Optional owner-only item inspection and self inventory grant/heal probes.
# Independent of character probes. Accepts exactly true or false.
REPLIPG_DEV_INVENTORY=false
# Required only when DEV_INVENTORY=true: positive decimal Telegram user ID.
# No sign, whitespace, username, or group administrator substitution is accepted.
REPLIPG_OWNER_TELEGRAM_USER_ID=
