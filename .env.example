# Required. Obtain a bot token from BotFather; use your numeric Telegram user ID.
REPLIPG_BOT_TOKEN=
REPLIPG_BOT_OWNER_ID=

# Optional defaults; relative paths resolve from the working directory.
REPLIPG_DATABASE_PATH=./data/replipg.db
REPLIPG_ASSETS_PATH=./assets
REPLIPG_ASSET_DEBOUNCE=300ms
REPLIPG_MENU_TTL=15m
REPLIPG_SHUTDOWN_TIMEOUT=10s
