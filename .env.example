# Required. Obtain a bot token from BotFather; use your numeric Telegram user ID.
REPLIPG_BOT_TOKEN=
REPLIPG_BOT_OWNER_ID=

# Optional defaults; relative paths resolve from the working directory.
REPLIPG_LOG_LEVEL=info
REPLIPG_DATABASE_PATH=./data/replipg.db
REPLIPG_ASSETS_PATH=./assets
REPLIPG_ASSET_DEBOUNCE=300ms
REPLIPG_MENU_TTL=15m
REPLIPG_SHUTDOWN_TIMEOUT=10s

# Optional bank integration. Set only a verified numeric bank bot ID.
# Leaving the ID empty disables new financial work and bank recovery sends.
REPLIPG_BANK_BOT_ID=
REPLIPG_BANK_TREASURY_ID=2

# Docker Compose local inference service (operated separately from the bot).
# NVIDIA GPU access is enabled; downloaded weights persist in a Docker volume.
REPLIPG_OLLAMA_IMAGE=ollama/ollama:latest
REPLIPG_OLLAMA_MODEL=qwen3:4b
REPLIPG_OLLAMA_PORT=11434

# Unknown recipe discovery is disabled until the local service/model is ready.
# Saved successful recipes remain available while discovery is disabled.
REPLIPG_CRAFTING_ENABLED=false
REPLIPG_CRAFTING_ENDPOINT=http://127.0.0.1:11434
REPLIPG_CRAFTING_MODEL=qwen3:4b
# Optional bearer token for a local reverse proxy; direct Ollama needs none.
REPLIPG_CRAFTING_TOKEN=
REPLIPG_CRAFTING_TIMEOUT=2m
REPLIPG_CRAFTING_MIN_INTERVAL=1s
REPLIPG_CRAFTING_MAX_RESPONSE_BYTES=65536
REPLIPG_CRAFTING_MAX_TOKENS=2048
